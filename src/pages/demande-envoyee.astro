---
/**
 * Confirmation après l'envoi du formulaire de demande.
 * Exclue des moteurs de recherche et du sitemap.
 */
import Base from '../layouts/Base.astro';
import Bouton from '../components/Bouton.astro';
import Icon from '../components/Icon.astro';
---

<Base titre="Demande envoyée" noindex>
  <section class="conteneur flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <span class="anim-entree inline-flex size-16 items-center justify-center rounded-full bg-primaire text-accent">
      <Icon nom="check" class="size-8" />
    </span>
    <h1 class="anim-entree mt-8 text-[2.5rem] md:text-6xl" style="--delai: 100ms">Demande <em>envoyée</em></h1>
    <p class="anim-entree mt-6 max-w-md text-lg text-gris" style="--delai: 200ms">
      Réponse par e-mail avec les créneaux disponibles. Pense à vérifier tes courriers indésirables.
    </p>
    <div class="anim-entree mt-10" style="--delai: 300ms">
      <Bouton href="/" variante="secondaire">Retour à l’accueil</Bouton>
    </div>
  </section>
</Base>
