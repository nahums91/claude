---
/**
 * En-tête flottant : une barre bleu nuit translucide, détachée des bords,
 * qui reste visible pendant le défilement.
 * - grand écran : logo, navigation, bouton principal
 * - tablette : logo, bouton principal, menu
 * - mobile : logo et menu (le bouton principal est dans le menu et dans la barre du bas)
 */
import Bouton from './Bouton.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site } from '../config/site';
import { offres } from '../config/offres';

const liens = [
  { href: '/alternance', label: 'Alternance' },
  { href: '/orientation', label: 'Orientation' },
  { href: '/#ebook', label: 'E-book' },
  { href: '/#faq', label: 'FAQ' },
];

const cheminActuel = Astro.url.pathname.replace(/\.html$/, '');
---

<header class="fixed inset-x-0 top-0 z-40 px-3 pt-3 md:px-5 md:pt-4">
  <div
    class="mx-auto max-w-[78rem] rounded-2xl border border-white/10 bg-sombre/85 text-creme shadow-[0_10px_40px_-20px_rgb(0_0_0/0.5)] backdrop-blur-md"
  >
    <div class="flex h-16 items-center justify-between gap-4 pr-2 pl-4 md:h-[4.5rem] md:pl-5">
      <a href="/" class="inline-flex min-h-11 items-center" aria-label={`${site.nom}, retour à l'accueil`}>
        <Logo />
      </a>

      <!-- Navigation grand écran -->
      <nav aria-label="Navigation principale" class="hidden xl:block">
        <ul class="flex items-center gap-1">
          {
            liens.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="mono inline-flex min-h-11 items-center px-4 text-creme/75 transition-colors hover:text-creme aria-[current=page]:text-accent"
                  aria-current={cheminActuel === l.href ? 'page' : undefined}
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <div class="hidden md:block">
          <Bouton href={offres.appelDecouverte.lien} fleche evenement="appel-decouverte-header">
            Réserver mon appel découverte gratuit
          </Bouton>
        </div>

        <!-- Bouton du menu (mobile et tablette) -->
        <button
          type="button"
          class="inline-flex size-12 items-center justify-center rounded-bouton border border-white/15 transition-colors hover:border-white/40 xl:hidden"
          aria-expanded="false"
          aria-controls="menu-mobile"
          aria-label="Ouvrir le menu"
          data-menu-bouton
        >
          <Icon nom="menu" class="size-5" />
        </button>
      </div>
    </div>

    <!-- Panneau du menu (masqué par défaut) -->
    <div id="menu-mobile" class="border-t border-white/10 xl:hidden" hidden data-menu-panneau>
      <nav aria-label="Navigation mobile" class="anim-entree px-4 py-4 md:px-5" style="--delai: 0ms">
        <ul class="flex flex-col">
          {
            liens.map((l, i) => (
              <li>
                <a
                  href={l.href}
                  class="flex min-h-14 items-center justify-between border-b border-white/10 text-2xl font-medium tracking-[-0.03em]"
                  aria-current={cheminActuel === l.href ? 'page' : undefined}
                >
                  <span class="flex items-baseline gap-4">
                    <span class="mono text-accent">0{i + 1}</span>
                    {l.label}
                  </span>
                  <Icon nom="fleche" class="size-5 text-sombre-doux" />
                </a>
              </li>
            ))
          }
        </ul>
        <div class="pt-5 pb-1 md:hidden">
          <Bouton href={offres.appelDecouverte.lien} pleineLargeur evenement="appel-decouverte-menu">
            Réserver mon appel découverte gratuit
          </Bouton>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  // Ouverture / fermeture du menu, accessible au clavier.
  const bouton = document.querySelector<HTMLButtonElement>('[data-menu-bouton]');
  const panneau = document.querySelector<HTMLElement>('[data-menu-panneau]');

  function basculer(ouvrir: boolean) {
    if (!bouton || !panneau) return;
    bouton.setAttribute('aria-expanded', String(ouvrir));
    bouton.setAttribute('aria-label', ouvrir ? 'Fermer le menu' : 'Ouvrir le menu');
    panneau.hidden = !ouvrir;
  }

  bouton?.addEventListener('click', () => {
    basculer(bouton.getAttribute('aria-expanded') !== 'true');
  });

  // Fermeture avec Échap, focus rendu au bouton
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && bouton?.getAttribute('aria-expanded') === 'true') {
      basculer(false);
      bouton.focus();
    }
  });

  // Fermeture quand on clique sur un lien (utile pour les ancres #faq, #ebook)
  panneau?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => basculer(false)));
</script>
