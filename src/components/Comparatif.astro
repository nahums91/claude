---
/**
 * Tableau comparatif des formules d'un parcours, généré depuis offres.ts.
 * Vrai tableau HTML (accessible), compacté sur mobile pour que les trois
 * formules restent visibles sans défilement horizontal.
 * La colonne de la formule mise en avant est surlignée.
 */
import Icon from './Icon.astro';
import type { Parcours } from '../config/offres';
import { formaterPrix } from '../config/offres';

interface Props {
  parcours: Parcours;
}

const { parcours: p } = Astro.props;
---

<div class="overflow-x-auto rounded-carte border border-ligne bg-surface" data-reveal>
  <table class="w-full table-fixed border-collapse text-left text-sm sm:text-base">
    <caption class="sr-only">Comparatif des formules du parcours {p.titre}</caption>
    <thead>
      <tr class="border-b border-ligne">
        <th scope="col" class="w-[31%] p-3 align-bottom sm:w-auto md:p-6"><span class="mono text-[0.625rem] text-gris sm:text-xs">Inclus</span></th>
        {
          p.formules.map((f) => (
            <th
              scope="col"
              class:list={['w-[23%] px-1 py-3 text-center align-bottom sm:w-[22%] sm:p-4 md:p-6', f.miseEnAvant && 'bg-sombre text-creme']}
            >
              <span class="font-titre block text-[0.6875rem] leading-tight font-bold sm:text-lg md:text-xl">{f.nom}</span>
              <span class:list={['mono mt-1 block text-[0.5625rem] sm:text-xs', f.miseEnAvant ? 'text-accent' : 'text-gris']}>{formaterPrix(f.prix)}</span>
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        p.comparatif.map((ligne) => (
          <tr class="border-b border-ligne last:border-b-0">
            <th scope="row" class="p-3 font-normal sm:p-4 md:px-6">{ligne.critere}</th>
            {p.formules.map((f) => {
              const v = ligne[f.id];
              return (
                <td class:list={['px-1 py-3 text-center sm:p-4 md:px-6', f.miseEnAvant && 'bg-sombre/[0.04]']}>
                  {v === true ? (
                    <span class="inline-flex size-7 items-center justify-center rounded-full bg-accent-doux text-accent-fonce">
                      <Icon nom="check" class="size-4" />
                      <span class="sr-only">Inclus</span>
                    </span>
                  ) : v === false || v === undefined ? (
                    <span class="text-gris/60">
                      <span aria-hidden="true">—</span>
                      <span class="sr-only">Non inclus</span>
                    </span>
                  ) : (
                    <span class="text-xs font-medium break-words sm:text-sm">{v}</span>
                  )}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
