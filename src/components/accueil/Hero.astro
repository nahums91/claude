---
/**
 * Hero de l'accueil : accroche, bouton principal, accès aux formules et photo.
 *
 * Motion : chaque bloc entre l'un après l'autre (classe anim-entree + --delai),
 * et trois pastilles flottent doucement autour de la photo.
 *
 * Le bloc [data-hero-cta] sert de repère à la barre d'action mobile :
 * elle n'apparaît qu'une fois ce bouton sorti de l'écran.
 */
import Bouton from '../Bouton.astro';
import Icon from '../Icon.astro';
import { offres } from '../../config/offres';

const appel = offres.appelDecouverte;

// Pastilles flottantes autour de la photo (reprennent le contenu des formules)
const pastilles = [
  { texte: 'Refonte du CV', position: 'top-6 -left-2 sm:-left-6', rotation: '-4deg', delai: '0s', vif: false },
  { texte: 'Profil LinkedIn', position: 'top-1/3 -right-2 sm:-right-6', rotation: '3deg', delai: '-2s', vif: false },
  { texte: 'Préparation aux entretiens', position: 'bottom-8 -left-2 sm:-left-8', rotation: '-2deg', delai: '-4s', vif: true },
];
---

<section class="conteneur overflow-x-clip pt-8 pb-16 md:pt-16 md:pb-24" aria-labelledby="hero-titre">
  <div class="grid items-center gap-12 lg:grid-cols-[1.2fr_0.8fr] lg:gap-16">
    <div>
      <p class="surtitre anim-entree">Coaching alternance et orientation</p>

      <h1
        id="hero-titre"
        class="anim-entree mt-5 text-[2.75rem] sm:text-6xl lg:text-[5.25rem]"
        style="--delai: 100ms"
      >
        [TITRE DU HERO : <em>ta promesse</em> en une phrase]
      </h1>

      <p class="anim-entree mt-6 max-w-xl text-lg text-gris md:text-xl" style="--delai: 200ms">
        [SOUS-TITRE DU HERO : pour qui, quel résultat]
      </p>

      <div
        class="anim-entree mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap"
        style="--delai: 300ms"
        data-hero-cta
      >
        <Bouton href={appel.lien} fleche evenement="appel-decouverte-hero">
          Réserver mon appel découverte gratuit
        </Bouton>
        <Bouton href="#parcours" variante="secondaire">Voir les formules</Bouton>
      </div>

      <!-- Rappel des modalités de l'appel, juste sous le bouton -->
      <ul
        class="anim-entree mt-6 flex flex-wrap gap-x-5 gap-y-2 text-[0.9375rem] text-gris"
        style="--delai: 400ms"
      >
        <li class="flex items-center gap-2"><Icon nom="horloge" class="size-5" />{appel.duree}</li>
        <li class="flex items-center gap-2"><Icon nom="visio" class="size-5" />En {appel.format.toLowerCase()}</li>
        <li class="flex items-center gap-2"><Icon nom="check" class="size-5" />Gratuit</li>
      </ul>
    </div>

    <!--
      Photo de Nahum.
      Quand tu l'as : dépose-la dans src/assets/nahum.jpg, puis remplace le bloc
      [PHOTO DE NAHUM] par <Image src={photo} alt="[DESCRIPTION DE LA PHOTO]" ... /> (voir README).
    -->
    <div class="anim-entree relative mx-auto w-full max-w-sm lg:max-w-none" style="--delai: 250ms">
      <div class="aspect-[4/5] w-full overflow-hidden rounded-[2rem] border border-ligne bg-surface">
        <div class="flex h-full items-center justify-center p-6 text-center text-gris">[PHOTO DE NAHUM]</div>
      </div>

      <!-- Pastilles décoratives (masquées des lecteurs d'écran) -->
      {
        pastilles.map((p) => (
          <span
            class:list={[
              'animate-flotte absolute inline-flex items-center gap-2 rounded-full border px-4 py-2.5 text-sm font-medium whitespace-nowrap shadow-[0_8px_30px_-12px_rgb(11_11_15/0.25)]',
              p.vif ? 'border-encre/10 bg-vif text-encre' : 'border-ligne bg-surface text-encre',
              p.position,
            ]}
            style={`--rotation: ${p.rotation}; animation-delay: ${p.delai}`}
            aria-hidden="true"
          >
            <span
              class:list={[
                'inline-flex size-5 items-center justify-center rounded-full',
                p.vif ? 'bg-encre text-vif' : 'bg-vif text-encre',
              ]}
            >
              <Icon nom="check" class="size-3.5" />
            </span>
            {p.texte}
          </span>
        ))
      }
    </div>
  </div>
</section>
