---
/**
 * Hero de l'accueil : accroche, bouton principal, accès aux formules et visuel.
 *
 * Pas de photo : à droite, un visuel composé de cartes d'interface (HeroVisuel).
 * Motion : chaque bloc entre l'un après l'autre (classe anim-entree + --delai).
 *
 * Le bloc [data-hero-cta] sert de repère à la barre d'action mobile :
 * elle n'apparaît qu'une fois ce bouton sorti de l'écran.
 */
import Bouton from '../Bouton.astro';
import Icon from '../Icon.astro';
import HeroVisuel from './HeroVisuel.astro';
import { offres } from '../../config/offres';

const appel = offres.appelDecouverte;

---

<section class="conteneur overflow-x-clip pt-8 pb-16 md:pt-16 md:pb-24" aria-labelledby="hero-titre">
  <div class="grid items-center gap-12 lg:grid-cols-[1.2fr_0.8fr] lg:gap-16">
    <div>
      <p class="surtitre anim-entree">Coaching alternance et orientation</p>

      <h1
        id="hero-titre"
        class="anim-entree mt-5 text-[2.75rem] sm:text-6xl lg:text-[5.25rem]"
        style="--delai: 100ms"
      >
        [TITRE DU HERO : <em>ta promesse</em> en une phrase]
      </h1>

      <p class="anim-entree mt-6 max-w-xl text-lg text-gris md:text-xl" style="--delai: 200ms">
        [SOUS-TITRE DU HERO : pour qui, quel résultat]
      </p>

      <div
        class="anim-entree mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap"
        style="--delai: 300ms"
        data-hero-cta
      >
        <Bouton href={appel.lien} fleche evenement="appel-decouverte-hero">
          Réserver mon appel découverte gratuit
        </Bouton>
        <Bouton href="#parcours" variante="secondaire">Voir les formules</Bouton>
      </div>

      <!-- Rappel des modalités de l'appel, juste sous le bouton -->
      <ul
        class="anim-entree mt-6 flex flex-wrap gap-x-5 gap-y-2 text-[0.9375rem] text-gris"
        style="--delai: 400ms"
      >
        <li class="flex items-center gap-2"><Icon nom="horloge" class="size-5" />{appel.duree}</li>
        <li class="flex items-center gap-2"><Icon nom="visio" class="size-5" />En {appel.format.toLowerCase()}</li>
        <li class="flex items-center gap-2"><Icon nom="check" class="size-5" />Gratuit</li>
      </ul>
    </div>

    <!-- Visuel sans photo : composition de cartes d'interface -->
    <div class="anim-entree" style="--delai: 250ms">
      <HeroVisuel />
    </div>
  </div>
</section>
