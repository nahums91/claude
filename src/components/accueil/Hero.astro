---
/**
 * Hero de l'accueil, sur fond clair :
 * à gauche l'accroche et le bouton principal, à droite le « dossier de
 * candidature » à onglets (voir Dossier.astro).
 *
 * Avec une photo (site.photoHero renseigné), elle remplace le dossier.
 *
 * Motion : les blocs entrent l'un après l'autre et le mot-clé du titre
 * se fait surligner en jaune.
 * Le bloc [data-hero-cta] sert de repère à la barre d'action mobile.
 */
import Bouton from '../Bouton.astro';
import Icon from '../Icon.astro';
import Dossier from './Dossier.astro';
import { offres } from '../../config/offres';
import { site } from '../../config/site';

const appel = offres.appelDecouverte;
---

<section class="conteneur pt-10 pb-16 md:pt-20 md:pb-24" aria-labelledby="hero-titre">
  <div class="grid items-center gap-14 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16">
    <div>
      <p class="surtitre anim-entree"><span>00</span> Coaching alternance et orientation</p>

      <h1
        id="hero-titre"
        class="anim-entree mt-6 text-[2.75rem] sm:text-6xl lg:text-[4.75rem]"
        style="--delai: 100ms"
      >
        [TITRE DU HERO : <em>votre promesse</em> en une phrase]
      </h1>

      <p class="anim-entree mt-6 max-w-xl text-lg text-gris md:text-xl" style="--delai: 200ms">
        [SOUS-TITRE DU HERO : pour qui, quel résultat]
      </p>

      <div
        class="anim-entree mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap"
        style="--delai: 300ms"
        data-hero-cta
      >
        <Bouton href={appel.lien} fleche evenement="appel-decouverte-hero">
          Réserver mon appel découverte gratuit
        </Bouton>
        <Bouton href="#parcours" variante="secondaire">Voir les formules</Bouton>
      </div>

      <!-- Rappel des modalités de l'appel, juste sous le bouton -->
      <ul class="anim-entree mt-6 flex flex-wrap gap-x-5 gap-y-2 text-[0.9375rem] text-gris" style="--delai: 400ms">
        <li class="flex items-center gap-2"><Icon nom="horloge" class="size-5 text-accent" />{appel.duree}</li>
        <li class="flex items-center gap-2"><Icon nom="visio" class="size-5 text-accent" />En {appel.format.toLowerCase()}</li>
        <li class="flex items-center gap-2"><Icon nom="check" class="size-5 text-accent" />Gratuit</li>
      </ul>
    </div>

    <div class="anim-entree" style="--delai: 250ms">
      {
        site.photoHero ? (
          <img
            src={site.photoHero}
            alt="[DESCRIPTION DE LA PHOTO]"
            class="aspect-[4/5] w-full rounded-carte object-cover"
            fetchpriority="high"
          />
        ) : (
          <Dossier />
        )
      }
    </div>
  </div>
</section>
