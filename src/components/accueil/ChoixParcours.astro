---
/**
 * Choix du parcours : la première décision du visiteur.
 * Deux grandes cartes (une par parcours), puis deux sorties de secours :
 * l'appel découverte pour qui hésite, l'e-book pour qui veut avancer seul.
 * Tous les textes et prix viennent de src/config/offres.ts.
 * Motion : apparition au défilement, carte qui se soulève et flèche qui se
 * remplit au survol.
 */
import Bouton from '../Bouton.astro';
import Icon, { type NomIcone } from '../Icon.astro';
import { offres, formaterPrix, prixMinimum } from '../../config/offres';

const icones: Record<string, NomIcone> = { alternance: 'document', orientation: 'boussole' };
const appel = offres.appelDecouverte;
---

<section id="parcours" class="section conteneur" aria-labelledby="parcours-titre">
  <div class="max-w-2xl" data-reveal>
    <p class="surtitre"><span>01</span> Votre parcours</p>
    <h2 id="parcours-titre" class="mt-5 text-[2.5rem] md:text-6xl">Choisissez votre <em>parcours</em></h2>
  </div>

  <ul class="mt-10 grid gap-5 md:grid-cols-2">
    {
      offres.parcours.map((p) => {
        const min = prixMinimum(p);
        return (
          <li data-reveal style={`--delai: ${(p.numero - 1) * 120}ms`}>
            <a
              href={`/${p.id}`}
              class="group flex h-full flex-col rounded-carte border border-ligne bg-surface p-6 transition-[transform,box-shadow,border-color] duration-500 ease-(--ease-douce) hover:-translate-y-1.5 hover:border-encre/20 hover:shadow-[0_24px_60px_-28px_rgb(11_11_15/0.35)] md:p-8"
            >
              <div class="flex items-center justify-between">
                <span class="inline-flex size-12 items-center justify-center rounded-xl bg-accent-doux text-accent">
                  <Icon nom={icones[p.id] ?? 'fleche'} class="size-6" />
                </span>
                <span class="mono text-gris">Parcours 0{p.numero}</span>
              </div>

              <h3 class="mt-8 text-[1.875rem] md:text-4xl">{p.titre}</h3>
              <p class="mt-3 text-gris">{p.resume}</p>
              <p class="mt-4 flex gap-2 text-[0.9375rem]">
                <Icon nom="communaute" class="mt-0.5 size-5 shrink-0 text-accent" />
                <span><span class="font-medium">Pour qui :</span> {p.pourQui}</span>
              </p>

              <ul class="mt-5 flex flex-wrap gap-2" aria-label="Formules">
                {p.formules.map((f) => (
                  <li class="rounded-full border border-ligne px-3 py-1 text-sm font-medium">{f.nom}</li>
                ))}
              </ul>

              <div class="mt-auto flex flex-wrap items-end justify-between gap-x-4 gap-y-2 pt-8">
                <p class="text-gris">
                  {min !== null ? (
                    <>
                      À partir de <strong class="font-titre text-3xl font-bold tracking-[-0.04em] text-encre">{formaterPrix(min)}</strong>
                    </>
                  ) : (
                    <>
                      {p.formules.length} formules
                    </>
                  )}
                </p>
                <span class="inline-flex min-h-12 items-center gap-3 font-medium whitespace-nowrap">
                  Voir les formules
                  <span class="inline-flex size-10 items-center justify-center rounded-bouton border border-ligne transition-colors duration-300 group-hover:border-accent group-hover:bg-accent group-hover:text-creme">
                    <Icon nom="fleche" class="size-5 transition-transform duration-300 group-hover:-rotate-45" />
                  </span>
                </span>
              </div>
            </a>
          </li>
        );
      })
    }
  </ul>

  <!-- Pour qui hésite : l'appel découverte -->
  <div
    class="fond-sombre mt-4 flex flex-col gap-6 rounded-carte bg-sombre p-6 text-creme md:flex-row md:items-center md:justify-between md:p-10"
    data-reveal
    style="--delai: 240ms"
  >
    <div class="max-w-xl">
      <h3 class="text-[1.75rem] md:text-4xl">Vous hésitez entre <em>les deux</em> ?</h3>
      <p class="mt-2 text-sombre-doux">
        {appel.nom} : {appel.duree}, en {appel.format.toLowerCase()}, gratuit. {appel.description}
      </p>
    </div>
    <Bouton href={appel.lien} variante="inverse" fleche class="shrink-0" evenement="appel-decouverte-parcours">
      Réserver mon appel découverte gratuit
    </Bouton>
  </div>

  <!-- Pour qui veut avancer seul : l'e-book -->
  <p class="mt-6 flex flex-wrap items-center gap-x-2 text-gris" data-reveal style="--delai: 300ms">
    <Icon nom="livre" class="size-5" />
    Vous préférez avancer en autonomie ?
    <a href="#ebook" class="inline-flex min-h-11 items-center font-medium text-encre underline decoration-soleil decoration-[3px] underline-offset-4">
      Découvrir l’e-book
    </a>
  </p>
</section>
