---
/**
 * 3 arguments, tirés de ton parcours (sans ajout de ma part).
 * Modifie librement les textes ci-dessous.
 * Motion : les cartes apparaissent l'une après l'autre au défilement.
 *
 * En dessous, une rangée de garanties concrètes (paiement, réservation,
 * format) pour rassurer tous les visiteurs, y compris les parents.
 */
import Icon, { type NomIcone } from '../Icon.astro';

const arguments_: { icone: NomIcone; titre: string; texte: string }[] = [
  {
    icone: 'diplome',
    titre: 'Étudiant à ICN Business School',
    texte: 'En dernière année du Programme Grande École, en alternance commerciale dans une grande ESN.',
  },
  {
    icone: 'telephone',
    titre: 'Ancien SDR',
    texte: 'Prospection, cold calling, LinkedIn.',
  },
  {
    icone: 'communaute',
    titre: 'Créateur de contenu',
    texte:
      'Plusieurs milliers d’abonnés sur TikTok, Instagram et LinkedIn, pour aider les étudiants à trouver une alternance.',
  },
];

const garanties: { icone: NomIcone; texte: string }[] = [
  { icone: 'cadenas', texte: 'Paiement sécurisé par Stripe' },
  { icone: 'calendrier', texte: 'Réservation en ligne via Cal.com' },
  { icone: 'visio', texte: 'Séances en visio' },
];
---

<section aria-label="Pourquoi me faire confiance" class="conteneur pt-16 md:pt-24">
  <ul class="grid gap-4 md:grid-cols-3">
    {
      arguments_.map((a, i) => (
        <li
          class="rounded-carte border border-ligne bg-surface p-6 md:p-7"
          data-reveal
          style={`--delai: ${i * 100}ms`}
        >
          <div class="flex items-center justify-between">
            <span class="inline-flex size-11 items-center justify-center rounded-xl bg-accent-doux text-accent-fonce">
              <Icon nom={a.icone} class="size-5" />
            </span>
            <span class="mono text-gris">0{i + 1}</span>
          </div>
          <h2 class="mt-6 text-xl tracking-[-0.03em] md:text-2xl">{a.titre}</h2>
          <p class="mt-2 text-gris">{a.texte}</p>
        </li>
      ))
    }
  </ul>

  <ul
    class="mt-4 grid gap-x-8 gap-y-3 rounded-carte border border-ligne px-6 py-5 sm:grid-cols-3 md:px-7"
    aria-label="Garanties"
    data-reveal
    style="--delai: 300ms"
  >
    {
      garanties.map((g) => (
        <li class="flex items-center gap-3 text-[0.9375rem] font-medium">
          <Icon nom={g.icone} class="size-5 shrink-0 text-accent-fonce" />
          {g.texte}
        </li>
      ))
    }
  </ul>
</section>
