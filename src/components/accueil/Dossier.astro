---
/**
 * « Dossier de candidature » : visuel du hero, sans photo.
 *
 * Une carte à onglets (CV, Lettre, LinkedIn, Entretiens). Chaque onglet montre
 * ce qui est travaillé et dans quelles formules c'est inclus (calculé depuis
 * le tableau comparatif de offres.ts : rien à mettre à jour à la main).
 *
 * Interaction : les onglets défilent seuls toutes les 4,5 s ; ils sont aussi
 * cliquables et utilisables au clavier (flèches gauche/droite). Le défilement
 * automatique s'arrête dès que le visiteur interagit, et ne démarre pas si
 * « Réduire les animations » est activé.
 *
 * Décor : une feuille en arrière-plan et un badge rond qui tourne lentement.
 */
import Icon from '../Icon.astro';
import { trouverParcours } from '../../config/offres';

const alternance = trouverParcours('alternance');

/** Noms des formules qui incluent un critère du tableau comparatif. */
function formulesIncluant(critere: string): string[] {
  const ligne = alternance.comparatif.find((l) => l.critere === critere);
  if (!ligne) return [];
  return alternance.formules.filter((f) => ligne[f.id]).map((f) => f.nom);
}

const onglets = [
  { id: 'cv', label: 'CV', titre: 'Refonte du CV', critere: 'Refonte du CV', type: 'cv' },
  { id: 'lettre', label: 'Lettre', titre: 'Lettre de motivation', critere: 'Refonte de la lettre de motivation', type: 'lettre' },
  { id: 'linkedin', label: 'LinkedIn', titre: 'Profil LinkedIn', critere: 'Refonte du profil LinkedIn', type: 'linkedin' },
  { id: 'entretiens', label: 'Entretiens', titre: 'Préparation aux entretiens', critere: 'Préparation aux entretiens', type: 'entretiens' },
].map((o) => ({ ...o, formules: formulesIncluant(o.critere) }));

const texteBadge = 'Coaching alternance · Orientation · ';
---

<div class="relative mx-auto w-full max-w-md pb-10 lg:max-w-none" data-dossier>
  <!-- Feuille en arrière-plan (effet pile de documents) -->
  <div
    class="absolute inset-x-6 top-10 bottom-2 rotate-[3deg] rounded-carte border border-creme/10 bg-sombre-2"
    aria-hidden="true"
  >
  </div>

  <div class="relative">
    <!-- Onglets façon intercalaires -->
    <div role="tablist" aria-label="Ce que l'on travaille ensemble" class="flex gap-1 pl-3">
      {
        onglets.map((o, i) => (
          <button
            type="button"
            role="tab"
            id={`onglet-${o.id}`}
            aria-controls={`panneau-${o.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="min-h-11 rounded-t-xl border border-b-0 border-creme/10 bg-sombre-2 px-3 text-sm font-medium text-sombre-doux transition-colors hover:text-creme aria-selected:border-ligne aria-selected:bg-surface aria-selected:text-encre sm:px-4"
            data-onglet
          >
            {o.label}
          </button>
        ))
      }
    </div>

    <!-- Panneaux -->
    <div class="relative -mt-px rounded-carte rounded-tl-none border border-ligne bg-surface p-5 text-encre shadow-[0_30px_60px_-35px_rgb(20_32_26/0.35)] sm:p-6">
      <!-- Barre de progression du défilement automatique -->
      <div class="absolute inset-x-6 top-0 h-0.5 overflow-hidden rounded-full" aria-hidden="true">
        <div class="h-full w-full origin-left scale-x-0 bg-primaire" data-progression></div>
      </div>

      {
        onglets.map((o, i) => (
          <div
            role="tabpanel"
            id={`panneau-${o.id}`}
            aria-labelledby={`onglet-${o.id}`}
            hidden={i !== 0}
            class="panneau-dossier"
          >
            <div class="flex items-center justify-between gap-3">
              <p class="font-titre text-xl font-bold tracking-[-0.03em]">{o.titre}</p>
              <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-primaire text-creme">
                <Icon nom="check" class="size-4" />
              </span>
            </div>

            <!-- Aperçu stylisé du document (décoratif) -->
            <div class="mt-5 rounded-xl border border-ligne bg-fond p-4" aria-hidden="true">
              {o.type === 'cv' && (
                <div class="space-y-2.5">
                  <div class="flex items-center gap-3">
                    <div class="size-9 rounded-lg bg-accent-doux" />
                    <div class="flex-1 space-y-1.5">
                      <div class="h-2.5 w-1/2 rounded-full bg-encre/80" />
                      <div class="h-2 w-1/3 rounded-full bg-ligne" />
                    </div>
                  </div>
                  <div class="trait-surligne h-2 w-11/12 rounded-full bg-ligne" />
                  <div class="h-2 w-4/5 rounded-full bg-ligne" />
                  <div class="h-2 w-2/3 rounded-full bg-ligne" />
                </div>
              )}
              {o.type === 'lettre' && (
                <div class="space-y-2">
                  <div class="h-2 w-1/3 rounded-full bg-encre/70" />
                  <div class="mt-3 h-2 w-full rounded-full bg-ligne" />
                  <div class="trait-surligne h-2 w-11/12 rounded-full bg-ligne" />
                  <div class="h-2 w-full rounded-full bg-ligne" />
                  <div class="h-2 w-3/5 rounded-full bg-ligne" />
                </div>
              )}
              {o.type === 'linkedin' && (
                <div>
                  <div class="h-10 rounded-lg bg-accent-doux" />
                  <div class="-mt-5 ml-3 size-11 rounded-full border-4 border-fond bg-primaire" />
                  <div class="mt-2 space-y-1.5">
                    <div class="trait-surligne h-2.5 w-1/2 rounded-full bg-encre/80" />
                    <div class="h-2 w-2/3 rounded-full bg-ligne" />
                  </div>
                </div>
              )}
              {o.type === 'entretiens' && (
                <div class="space-y-2.5">
                  <div class="w-3/4 rounded-2xl rounded-bl-sm bg-accent-doux p-3">
                    <div class="h-2 w-4/5 rounded-full bg-primaire/40" />
                  </div>
                  <div class="ml-auto w-3/4 rounded-2xl rounded-br-sm bg-primaire p-3">
                    <div class="trait-surligne h-2 w-full rounded-full bg-creme/50" />
                    <div class="mt-1.5 h-2 w-2/3 rounded-full bg-creme/50" />
                  </div>
                </div>
              )}
            </div>

            <!-- Formules qui incluent cet élément -->
            {o.formules.length > 0 && (
              <p class="mt-4 flex flex-wrap items-center gap-1.5 text-sm">
                <span class="mono mr-1 text-[0.6875rem] text-gris">Inclus dans</span>
                {o.formules.map((nom) => (
                  <span class="rounded-full border border-ligne px-2.5 py-0.5 font-medium">{nom}</span>
                ))}
              </p>
            )}
          </div>
        ))
      }
    </div>
  </div>

  <!-- Badge rond qui tourne lentement (décoratif) -->
  <div class="absolute -right-1 -bottom-8 size-24 sm:-right-4 sm:size-28" aria-hidden="true">
    <svg viewBox="0 0 100 100" class="badge-tourne size-full">
      <defs>
        <path id="cercle-badge" d="M50,50 m-37,0 a37,37 0 1,1 74,0 a37,37 0 1,1 -74,0"></path>
      </defs>
      <circle cx="50" cy="50" r="49" fill="var(--color-accent)"></circle>
      <text font-family="var(--font-mono)" font-size="8.4" letter-spacing="1.2" fill="var(--color-encre)">
        <textPath href="#cercle-badge">{texteBadge.toUpperCase()}</textPath>
      </text>
    </svg>
    <span class="absolute inset-0 flex items-center justify-center text-encre">
      <Icon nom="boussole" class="size-6" />
    </span>
  </div>
</div>

<style>
  /* Rotation lente du badge */
  .badge-tourne {
    animation: tourne 18s linear infinite;
  }
  @keyframes tourne {
    to {
      transform: rotate(360deg);
    }
  }

  /* Trait jaune qui « surligne » une ligne du document à chaque affichage */
  .trait-surligne {
    position: relative;
    overflow: hidden;
  }
  .trait-surligne::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    transform-origin: left;
    animation: surligne-ligne 0.8s var(--ease-douce) 0.25s both;
  }
  @keyframes surligne-ligne {
    from {
      transform: scaleX(0);
    }
  }

  /* Apparition douce d'un panneau */
  .panneau-dossier:not([hidden]) {
    animation: panneau 0.5s var(--ease-douce) both;
  }
  @keyframes panneau {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
</style>

<script>
  // Onglets accessibles + défilement automatique.
  const DUREE = 4500;

  document.querySelectorAll<HTMLElement>('[data-dossier]').forEach((dossier) => {
    const onglets = [...dossier.querySelectorAll<HTMLButtonElement>('[data-onglet]')];
    const progression = dossier.querySelector<HTMLElement>('[data-progression]');
    let actif = 0;
    let minuteur: number | undefined;
    let arrete = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function activer(index: number, focus = false) {
      actif = (index + onglets.length) % onglets.length;
      onglets.forEach((o, i) => {
        const selection = i === actif;
        o.setAttribute('aria-selected', String(selection));
        o.tabIndex = selection ? 0 : -1;
        const panneau = document.getElementById(o.getAttribute('aria-controls')!);
        if (panneau) panneau.hidden = !selection;
      });
      if (focus) onglets[actif].focus();
      relancerProgression();
    }

    // La barre se remplit pendant DUREE, puis on passe à l'onglet suivant
    function relancerProgression() {
      if (!progression) return;
      progression.getAnimations().forEach((a) => a.cancel());
      if (arrete) return;
      progression.animate([{ transform: 'scaleX(0)' }, { transform: 'scaleX(1)' }], {
        duration: DUREE,
        easing: 'linear',
        fill: 'forwards',
      });
    }

    function demarrer() {
      if (arrete) return;
      window.clearInterval(minuteur);
      minuteur = window.setInterval(() => activer(actif + 1), DUREE);
      relancerProgression();
    }

    function arreter() {
      arrete = true;
      window.clearInterval(minuteur);
      progression?.getAnimations().forEach((a) => a.cancel());
    }

    onglets.forEach((o, i) => {
      o.addEventListener('click', () => {
        arreter();
        activer(i);
      });
      o.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          arreter();
          activer(actif + (e.key === 'ArrowRight' ? 1 : -1), true);
        }
      });
    });

    // Pause pendant le survol, reprise ensuite (sauf si le visiteur a cliqué)
    dossier.addEventListener('mouseenter', () => {
      window.clearInterval(minuteur);
      progression?.getAnimations().forEach((a) => a.pause());
    });
    dossier.addEventListener('mouseleave', () => {
      if (!arrete) demarrer();
    });

    demarrer();
  });
</script>
