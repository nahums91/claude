---
/**
 * Visuel du hero, sans photo : une composition de cartes d'interface qui
 * montre concrètement ce que tu proposes (CV retravaillé, profil LinkedIn,
 * réservation de l'appel découverte).
 *
 * Purement décoratif (aria-hidden) : les informations utiles sont déjà dans
 * le texte du hero. Les lignes grises imitent du texte, sans contenu inventé.
 * Motion : les cartes flottent très légèrement, chacune à son rythme.
 */
import Icon from '../Icon.astro';
import { offres } from '../../config/offres';

const appel = offres.appelDecouverte;

// Mini-calendrier décoratif : 2 semaines, un jour sélectionné
const jours = Array.from({ length: 14 }, (_, i) => i + 8);
const jourChoisi = 17;
---

<div class="relative mx-auto aspect-square w-full max-w-md select-none lg:max-w-none" aria-hidden="true">
  <!-- Fond du visuel -->
  <div class="absolute inset-0 rounded-[2rem] border border-ligne bg-accent-doux"></div>

  <!-- Carte 1 : le CV -->
  <div
    class="animate-flotte absolute top-[8%] left-[6%] w-[54%] rounded-2xl border border-ligne bg-surface p-4 shadow-[0_20px_50px_-24px_rgb(11_11_15/0.3)] sm:p-5"
    style="animation-delay: 0s"
  >
    <div class="flex items-center gap-2">
      <span class="inline-flex size-8 items-center justify-center rounded-lg bg-accent-doux text-accent">
        <Icon nom="document" class="size-4" />
      </span>
      <span class="text-sm font-semibold">CV</span>
    </div>
    <div class="mt-4 space-y-2">
      <div class="h-2 w-4/5 rounded-full bg-encre/80"></div>
      <div class="h-2 w-3/5 rounded-full bg-ligne"></div>
      <div class="mt-3 h-2 w-full rounded-full bg-ligne"></div>
      <div class="h-2 w-11/12 rounded-full bg-ligne"></div>
      <div class="h-2 w-2/3 rounded-full bg-ligne"></div>
    </div>
    <span class="mt-4 inline-flex items-center gap-1.5 rounded-full bg-accent px-2.5 py-1 text-xs font-medium text-white">
      <Icon nom="check" class="size-3.5" /> Refonte du CV
    </span>
  </div>

  <!-- Carte 2 : réservation de l'appel découverte -->
  <div
    class="animate-flotte absolute top-[20%] right-[5%] z-10 w-[52%] rounded-2xl border border-ligne bg-surface p-4 shadow-[0_24px_60px_-24px_rgb(11_11_15/0.35)] sm:p-5"
    style="animation-delay: -2.5s"
  >
    <div class="flex items-center gap-2">
      <span class="inline-flex size-8 items-center justify-center rounded-lg bg-accent-doux text-accent">
        <Icon nom="calendrier" class="size-4" />
      </span>
      <span class="text-sm leading-tight font-semibold">{appel.nom}</span>
    </div>
    <p class="mt-2 text-xs text-gris">{appel.duree} · {appel.format} · Gratuit</p>
    <div class="mt-3 grid grid-cols-7 gap-1">
      {
        jours.map((j) => (
          <span
            class:list={[
              'flex aspect-square items-center justify-center rounded-md text-[0.625rem] font-medium',
              j === jourChoisi ? 'bg-accent text-white' : 'bg-fond text-gris',
            ]}
          >
            {j}
          </span>
        ))
      }
    </div>
    <span class="mt-3 flex h-8 items-center justify-center rounded-full bg-encre text-xs font-medium text-white">
      Réserver
    </span>
  </div>

  <!-- Carte 3 : le profil LinkedIn -->
  <div
    class="animate-flotte absolute bottom-[6%] left-[6%] w-[50%] rounded-2xl border border-ligne bg-surface p-4 shadow-[0_20px_50px_-24px_rgb(11_11_15/0.3)] sm:p-5"
    style="animation-delay: -5s"
  >
    <div class="flex items-center gap-3">
      <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-full bg-accent-doux text-accent">
        <Icon nom="linkedin" class="size-5" />
      </span>
      <div class="flex-1 space-y-1.5">
        <div class="h-2 w-3/4 rounded-full bg-encre/80"></div>
        <div class="h-2 w-1/2 rounded-full bg-ligne"></div>
      </div>
    </div>
    <span class="mt-4 inline-flex items-center gap-1.5 rounded-full bg-vif px-2.5 py-1 text-xs font-medium text-encre">
      <Icon nom="check" class="size-3.5" /> Profil LinkedIn
    </span>
  </div>
</div>
