---
/**
 * Logo provisoire : monogramme « N » en italique dans un carré, puis le nom.
 * À remplacer par ton vrai logo le jour où tu en as un.
 */
interface Props {
  class?: string;
}
const { class: classe = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-3', classe]}>
  <span
    class="inline-flex size-8 items-center justify-center rounded-md border border-accent/70 font-serif text-xl leading-none text-accent italic"
    aria-hidden="true">N</span
  >
  <span class="text-[0.9375rem] font-medium tracking-[0.2em] uppercase">
    Nahum<span class="text-accent">.</span>Apc
  </span>
</span>
