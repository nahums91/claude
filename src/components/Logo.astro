 * À remplacer par ton vrai logo le jour où tu en as un.
 */
interface Props {
  class?: string;
}
const { class: classe = '' } = Astro.props;
---

<span class:list={['font-titre inline-flex items-baseline text-[1.375rem] font-bold tracking-[-0.04em]', classe]}>
