---
/**
 * Pied de page : rappel de l'identité, navigation, réseaux, contact et liens légaux.
 */
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site } from '../config/site';

const reseaux = [
  { nom: 'TikTok', icone: 'tiktok', url: site.reseaux.tiktok },
  { nom: 'Instagram', icone: 'instagram', url: site.reseaux.instagram },
  { nom: 'LinkedIn', icone: 'linkedin', url: site.reseaux.linkedin },
] as const;

const colonnes = [
  {
    titre: 'Parcours',
    liens: [
      { href: '/alternance', label: 'Décrocher votre alternance' },
      { href: '/orientation', label: 'Clarifier votre projet' },
      { href: '/#ebook', label: 'E-book' },
    ],
  },
  {
    titre: 'Infos',
    liens: [
      { href: '/#faq', label: 'FAQ' },
      { href: '/mentions-legales', label: 'Mentions légales' },
      { href: '/cgv', label: 'CGV' },
      { href: '/confidentialite', label: 'Confidentialité' },
    ],
  },
];

const annee = new Date().getFullYear();
---

<footer class="fond-sombre bg-sombre pt-16 pb-28 text-creme lg:pb-12">
  <div class="conteneur">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <a href="/" class="inline-flex min-h-11 items-center" aria-label={`${site.nom}, retour à l'accueil`}>
          <Logo />
        </a>
        <p class="mt-3 max-w-xs text-sombre-doux">Coaching alternance et orientation.</p>

        <ul class="mt-6 flex gap-2" aria-label="Réseaux sociaux">
          {
            reseaux
              .filter((r) => r.url)
              .map((r) => (
                <li>
                  <a
                    href={r.url}
                    class="inline-flex size-12 items-center justify-center rounded-bouton border border-creme/15 transition-colors hover:border-accent hover:text-accent"
                    aria-label={`${r.nom} de ${site.nom}`}
                    rel="noopener"
                  >
                    <Icon nom={r.icone} class="size-5" />
                  </a>
                </li>
              ))
          }
        </ul>

        <a
          href={`mailto:${site.contact.email}`}
          class="mt-4 inline-flex min-h-11 items-center gap-2 font-medium underline decoration-creme/30 decoration-1 underline-offset-4 hover:decoration-accent"
        >
          <Icon nom="mail" class="size-5" />
          {site.contact.email}
        </a>
      </div>

      {
        colonnes.map((c) => (
          <nav aria-label={c.titre}>
            <h2 class="mono text-accent">{c.titre}</h2>
            <ul class="mt-3">
              {c.liens.map((l) => (
                <li>
                  <a href={l.href} class="inline-flex min-h-11 items-center text-creme/85 transition-colors hover:text-accent">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <!-- Identité légale visible : un signal de sérieux, notamment pour les parents -->
    <div class="mono mt-14 flex flex-col gap-2 border-t border-creme/10 pt-6 text-[0.625rem] text-sombre-doux md:flex-row md:justify-between">
      <p>© {annee} {site.nom}. Tous droits réservés.</p>
      <p>{site.legal.nomComplet} · {site.legal.statut} · SIRET {site.legal.siret}</p>
    </div>
  </div>
</footer>
