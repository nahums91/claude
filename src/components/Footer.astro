---
/**
 * Pied de page : rappel de l'identité, navigation, réseaux, contact et liens légaux.
 */
import Icon from './Icon.astro';
import { site } from '../config/site';

const reseaux = [
  { nom: 'TikTok', icone: 'tiktok', url: site.reseaux.tiktok },
  { nom: 'Instagram', icone: 'instagram', url: site.reseaux.instagram },
  { nom: 'LinkedIn', icone: 'linkedin', url: site.reseaux.linkedin },
] as const;

const colonnes = [
  {
    titre: 'Parcours',
    liens: [
      { href: '/alternance', label: 'Décrocher ton alternance' },
      { href: '/orientation', label: 'Clarifier ton projet' },
      { href: '/#ebook', label: 'E-book' },
    ],
  },
  {
    titre: 'Infos',
    liens: [
      { href: '/#faq', label: 'FAQ' },
      { href: '/mentions-legales', label: 'Mentions légales' },
      { href: '/cgv', label: 'CGV' },
      { href: '/confidentialite', label: 'Confidentialité' },
    ],
  },
];

const annee = new Date().getFullYear();
---

<footer class="border-t border-ligne pt-14 pb-28 lg:pb-12">
  <div class="conteneur">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <a href="/" class="font-titre inline-flex min-h-11 items-center text-2xl font-bold tracking-[-0.05em]">
          Nahum<span class="text-accent">.</span>Apc
        </a>
        <p class="mt-2 max-w-xs text-gris">Coaching alternance et orientation.</p>

        <ul class="mt-6 flex gap-2" aria-label="Réseaux sociaux">
          {
            reseaux
              .filter((r) => r.url)
              .map((r) => (
                <li>
                  <a
                    href={r.url}
                    class="inline-flex size-12 items-center justify-center rounded-full border border-ligne transition-colors hover:border-encre"
                    aria-label={`${r.nom} de ${site.nom}`}
                    rel="noopener"
                  >
                    <Icon nom={r.icone} class="size-5" />
                  </a>
                </li>
              ))
          }
        </ul>

        <a
          href={`mailto:${site.contact.email}`}
          class="mt-4 inline-flex min-h-11 items-center gap-2 font-medium underline decoration-ligne decoration-2 underline-offset-4 hover:decoration-encre"
        >
          <Icon nom="mail" class="size-5" />
          {site.contact.email}
        </a>
      </div>

      {
        colonnes.map((c) => (
          <nav aria-label={c.titre}>
            <h2 class="text-sm font-medium text-gris">{c.titre}</h2>
            <ul class="mt-3">
              {c.liens.map((l) => (
                <li>
                  <a href={l.href} class="inline-flex min-h-11 items-center hover:underline">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <p class="mt-12 border-t border-ligne pt-6 text-sm text-gris">
      © {annee} {site.nom}. Tous droits réservés.
    </p>
  </div>
</footer>
